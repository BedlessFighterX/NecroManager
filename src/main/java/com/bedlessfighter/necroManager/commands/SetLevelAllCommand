package com.bedlessfighter.necroManager.commands;
import com.bedlessfighter.necroManager.PermissionManager;import com.bedlessfighter.necroManager.MessageManager;import org.bukkit.Bukkit;import org.bukkit.command.*;import org.bukkit.entity.Player;
public final class SetLevelAllCommand implements CommandExecutor{public boolean onCommand(CommandSender s,Command c,String l,String[] a){if(!PermissionManager.has(s,"necromanager.setlevelall")){MessageManager.send(s,"messages.no-permission","&cYou do not have permission.");return true;}if(a.length!=1){s.sendMessage("Usage: /setlevelall <level>");return true;}int n;try{n=Integer.parseInt(a[0]);}catch(NumberFormatException e){s.sendMessage("Level must be an integer.");return true;}if(n<0||n>10000){s.sendMessage("Level must be 0-10000.");return true;}for(Player p:Bukkit.getOnlinePlayers())p.setLevel(n);MessageManager.sendRaw(s,"&aSet all online players' levels to "+n+".");return true;}}